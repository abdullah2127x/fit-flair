# ===== Sanity =====
# Sanity project ID (public)
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
# Sanity dataset name, e.g. production (public)
NEXT_PUBLIC_SANITY_DATASET="production"
# Sanity API token (SECRET - keep private, used for server-side writes/imports)
SANITY_API_TOKEN="your_sanity_api_token"

# ===== API =====
# Base URL for API calls (public)
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# ===== Stripe =====
# Stripe publishable key (public)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
# Stripe secret key (SECRET - keep private)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# ===== Clerk =====
# Clerk publishable key (public)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
# Clerk secret key (SECRET - keep private)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Clerk webhook signing secret (SECRET - keep private)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# Clerk user IDs allowed in the admin panel (public)
NEXT_PUBLIC_ADMIN_CLERK_IDS="user_xxx,user_yyy"

# ===== MongoDB =====
# MongoDB connection string (SECRET - keep private)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/dbname

# ===== Environment =====
# development | production | test
NODE_ENV=development

# Optional: canonical site URL for production builds
# NEXT_PUBLIC_URL="https://your-domain.com"
